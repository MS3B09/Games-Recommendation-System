# Backend configuration placeholders. Audit/collection/encoder jobs use CLI
# arguments; environment-check reads the file explicitly via --env-file.
# Copy to backend/.env for DB configuration; API setup is a later milestone.
# Server-only runtime connection: least-privilege role, never frontend config.
DATABASE_URL=postgresql://game_discovery_runtime.PROJECT_REF:REPLACE_LOCALLY@SESSION_POOLER_HOST:5432/postgres
# Server-only import/migration connection: separate privileged role.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_LOCALLY@SESSION_POOLER_HOST:5432/postgres
# Optional AI enhancement; leave disabled for core discovery.
GROQ_API_KEY=
GROQ_MODEL=
AI_ENABLED=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional explicit local env-file location; deployed services use environment settings.
# GAME_DISCOVERY_ENV_FILE=backend/.env
