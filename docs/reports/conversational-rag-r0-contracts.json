        "title": "Legacy Query",
        "type": "string"
      },
      "provenance": {
        "additionalProperties": {
          "$ref": "#/$defs/Origin"
        },
        "maxProperties": 10,
        "propertyNames": {
          "enum": [
            "min_price_cents",
            "max_price_cents",
            "price_operator",
            "free_only",
            "platforms",
            "platform_match",
            "required_modes",
            "required_genres",
            "preferred_terms",
            "unwanted_terms"
          ]
        },
        "title": "Provenance",
        "type": "object"
      },
      "query": {
        "default": "",
        "maxLength": 1000,
        "title": "Query",
        "type": "string"
      },
      "query_origin": {
        "anyOf": [
          {
            "$ref": "#/$defs/Origin"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "referenced_ids": {
        "items": {
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "type": "integer"
        },
        "maxItems": 2,
        "title": "Referenced Ids",
        "type": "array"
      },
      "shown_ids": {
        "items": {
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "type": "integer"
        },
        "maxItems": 4,
        "title": "Shown Ids",
        "type": "array"
      },
      "user_turn": {
        "default": 0,
        "maximum": 1000000,
        "minimum": 0,
        "title": "User Turn",
        "type": "integer"
      },
      "version": {
        "const": 2,
        "default": 2,
        "title": "Version",
        "type": "integer"
      }
    },
    "title": "ChatStateV2",
    "type": "object"
  },
  "RetrievalOutcome": {
