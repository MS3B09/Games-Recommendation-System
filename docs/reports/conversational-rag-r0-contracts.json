{
  "ChatStateV2": {
    "$defs": {
      "ChatCriteria": {
        "additionalProperties": false,
        "properties": {
          "excluded_ids": {
            "items": {
              "exclusiveMinimum": 0,
              "maximum": 2147483647,
              "type": "integer"
            },
            "maxItems": 200,
            "title": "Excluded Ids",
            "type": "array"
          },
          "free_only": {
            "default": false,
            "title": "Free Only",
            "type": "boolean"
          },
          "max_price_cents": {
            "anyOf": [
              {
                "maximum": 1000000,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Price Cents"
          },
          "min_price_cents": {
            "anyOf": [
              {
                "maximum": 1000000,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Min Price Cents"
          },
          "platform_match": {
            "default": "any",
            "enum": [
              "any",
              "all"
            ],
            "title": "Platform Match",
            "type": "string"
          },
          "platforms": {
            "items": {
              "enum": [
                "windows",
                "mac",
                "linux"
              ],
              "type": "string"
