              "lte",
              "lt"
            ],
            "title": "Price Operator",
            "type": "string"
          },
          "required_genres": {
            "items": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 30,
            "title": "Required Genres",
            "type": "array"
          },
          "required_modes": {
            "items": {
              "enum": [
                "single-player",
                "multiplayer",
                "online-co-op",
                "local-co-op"
              ],
              "type": "string"
            },
            "maxItems": 4,
            "title": "Required Modes",
            "type": "array"
          },
          "unwanted_terms": {
            "items": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 30,
            "title": "Unwanted Terms",
            "type": "array"
          }
        },
        "title": "ChatCriteria",
        "type": "object"
